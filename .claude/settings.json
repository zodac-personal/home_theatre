{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-no-personal-info.sh",
            "statusMessage": "Checking for personal info leaks..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/ai-sandbox/rules/hooks/guard-git-branch.sh"
          }
        ]
      }
    ]
  },
  "attribution": false
}
